<ui:FluentWindow x:Class="Cooldown.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:local="clr-namespace:Cooldown"
                 Title="Cooldown" Width="900" Height="640" MinWidth="760" MinHeight="500"
                 WindowStartupLocation="CenterScreen" Icon="pack://application:,,,/Assets/Cooldown.png"
                 ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica" WindowCornerPreference="Round">
    <ui:FluentWindow.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <SolidColorBrush x:Key="SessionBrush" Color="#FFFF9F0A" />

        <!-- Green while the weekly reset is less than a day away -->
        <Style x:Key="CountdownText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Soon}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="2,24,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Like the Windows 11 Settings sidebar: a soft highlight and an accent bar, not a solid fill -->
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="0,2" Padding="12,0,10,0">
                            <Grid>
                                <Border x:Name="Indicator" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left" Margin="-12,0,0,0"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                                <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="ResetListItem" DataType="{x:Type local:ResetView}">
            <StackPanel Margin="4,8,4,9">
                <Grid>
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,0,90,0" />
                    <TextBlock Text="{Binding Countdown}" HorizontalAlignment="Right" Style="{StaticResource CountdownText}" FontSize="12" VerticalAlignment="Center" />
                </Grid>
                <local:Bar Fraction="{Binding WeekProgress}" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,7,0,0" Height="3" />
                <TextBlock Margin="0,6,0,0" Style="{StaticResource Caption}">
                    <Run Text="{Binding ScheduleText, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource SessionBrush}"
                           Visibility="{Binding SessionRunning, Converter={StaticResource Visible}}">
                    <Run Text="{Binding SessionLabel, Mode=OneWay}" /><Run Text=": " /><Run Text="{Binding SessionCountdown, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>
        </DataTemplate>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Cooldown">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/Cooldown.png" Width="18" Height="18" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ===== Left: your AIs ===== -->
            <DockPanel Grid.Column="0" Margin="12,4,8,12">
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                    <ui:Button x:Name="AddButton" Content="Add an AI" Icon="{ui:SymbolIcon Add24}" HorizontalAlignment="Stretch"
                               Click="Add_Click" Margin="0,0,0,6" />
                    <ui:Button x:Name="SettingsButton" Content="Settings" Icon="{ui:SymbolIcon Settings24}" HorizontalAlignment="Stretch"
                               HorizontalContentAlignment="Left" Appearance="Transparent" Click="Settings_Click" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Top" Text="Your AIs" Style="{StaticResource Caption}" Margin="10,4,0,6" />
                <ListBox x:Name="List" ItemsSource="{Binding Resets}" ItemTemplate="{StaticResource ResetListItem}" ItemContainerStyle="{StaticResource NavItem}"
                         SelectionChanged="List_SelectionChanged" BorderThickness="0" Background="Transparent"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>

            <!-- ===== Right: the selected AI, or settings ===== -->
            <Border Grid.Column="1" Margin="0,0,12,12" CornerRadius="8"
                    Background="{DynamicResource LayerFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="1">
                <Grid>
                    <!-- Welcome / empty state -->
                    <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed" MaxWidth="360">
                        <ui:SymbolIcon Symbol="Timer24" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <TextBlock Text="Track when your AI limits reset" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock Text="Add an AI and the day and time its weekly limit resets. Cooldown counts down to it from your taskbar."
                                   Style="{StaticResource Caption}" TextAlignment="Center" />
                        <ui:Button Content="Add an AI" Icon="{ui:SymbolIcon Add24}" Appearance="Primary" HorizontalAlignment="Center" Margin="0,18,0,0" Click="Add_Click" />
                    </StackPanel>

                    <!-- One AI -->
                    <ScrollViewer x:Name="ResetPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="28,22,28,28">
                            <ui:InfoBar x:Name="WelcomeBar" Title="Welcome to Cooldown" IsOpen="False" Severity="Informational" Margin="0,0,0,16"
                                        Message="Set the day and time your AI's weekly limit resets. You'll find the countdown in your taskbar, next to the clock." />

                            <ui:TextBox x:Name="NameBox" FontSize="24" FontWeight="SemiBold" PlaceholderText="Name, like Claude"
                                        TextChanged="NameBox_TextChanged" />
                            <TextBlock x:Name="NameError" Foreground="{DynamicResource SystemFillColorCriticalBrush}" FontSize="12"
                                       Margin="2,6,0,0" Visibility="Collapsed" />

                            <!-- Weekly countdown -->
                            <ui:Card Margin="0,16,0,0" Padding="20,18">
                                <StackPanel>
                                    <TextBlock Text="Weekly limit resets in" Style="{StaticResource Caption}" />
                                    <TextBlock Text="{Binding Countdown}" FontSize="34" FontWeight="SemiBold" Style="{StaticResource CountdownText}" Margin="0,2,0,0" />
                                    <local:Bar Fraction="{Binding WeekProgress}" Fill="{DynamicResource SystemFillColorSuccessBrush}" Margin="0,10,0,0" />
                                    <TextBlock Margin="0,8,0,0" Style="{StaticResource Caption}">
                                        <Run Text="Next reset: " /><Run Text="{Binding NextText, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Text="When it resets" Style="{StaticResource SectionTitle}" />
                            <ui:Card Padding="16,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ui:SymbolIcon Symbol="CalendarLtr24" FontSize="20" VerticalAlignment="Top" Margin="0,2,14,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Every week on" FontWeight="SemiBold" />
                                        <TextBlock Text="At this time in your own time zone" Style="{StaticResource Caption}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <ComboBox x:Name="DayBox" MinWidth="140" SelectionChanged="Day_Changed" Margin="0,0,12,6" />
                                            <local:TimeInput x:Name="TimeBox" Margin="0,0,0,6" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </ui:Card>

                            <TextBlock Text="Session limit" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl Icon="{ui:SymbolIcon Timer24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Also has a rolling limit" FontWeight="SemiBold" />
                                        <TextBlock Text="A window that starts when you start chatting, like Claude's 5 hours" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <StackPanel Orientation="Horizontal">
                                    <ui:NumberBox x:Name="HoursBox" Minimum="1" Maximum="24" MaxDecimalPlaces="0" Width="110" Margin="0,0,8,0"
                                                  SpinButtonPlacementMode="Inline" ValueChanged="Hours_Changed" />
                                    <TextBlock Text="hours" VerticalAlignment="Center" Margin="0,0,16,0" />
                                    <ui:ToggleSwitch x:Name="SessionSwitch" Checked="Session_Toggled" Unchecked="Session_Toggled" />
                                </StackPanel>
                            </ui:CardControl>

                            <!-- The current session -->
                            <ui:Card x:Name="SessionCard" Margin="0,4,0,0" Padding="20,16"
                                     Visibility="{Binding HasSession, Converter={StaticResource Visible}}">
                                <StackPanel>
                                    <!-- Running -->
                                    <StackPanel Visibility="{Binding SessionRunning, Converter={StaticResource Visible}}">
                                        <TextBlock Style="{StaticResource Caption}"><Run Text="{Binding SessionLabel, Mode=OneWay}" /><Run Text=" resets in" /></TextBlock>
                                        <TextBlock Text="{Binding SessionCountdown}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource SessionBrush}" />
                                        <local:Bar Fraction="{Binding SessionProgress}" Fill="{StaticResource SessionBrush}" Margin="0,10,0,0" />
                                        <DockPanel Margin="0,12,0,0" LastChildFill="False">
                                            <TextBlock Text="{Binding SessionResetText}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                            <ui:Button DockPanel.Dock="Right" Content="End session" Icon="{ui:SymbolIcon Stop24}" Click="EndSession_Click" Margin="8,0,0,0" />
                                            <ui:Button DockPanel.Dock="Right" Content="Undo" Icon="{ui:SymbolIcon ArrowUndo24}" Command="{Binding UndoCommand}"
                                                       Visibility="{Binding ShowUndo, Converter={StaticResource Visible}}" />
                                        </DockPanel>
                                    </StackPanel>
                                    <!-- Not started -->
                                    <DockPanel Visibility="{Binding SessionIdle, Converter={StaticResource Visible}}" LastChildFill="False">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Not started" FontWeight="SemiBold" />
                                            <TextBlock Text="Start it when you start chatting" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                        <ui:Button DockPanel.Dock="Right" Content="Start now" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" Command="{Binding StartCommand}" />
                                    </DockPanel>
                                    <!-- Set the time the AI shows -->
                                    <Border Height="1" Background="{DynamicResource DividerStrokeColorDefaultBrush}" Margin="0,16,0,14" />
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="Or set when it resets, as your AI shows it" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                                        <ui:Button DockPanel.Dock="Right" Content="Set" Click="SetSession_Click" Margin="8,0,0,0" />
                                        <local:TimeInput x:Name="SessionTimeBox" DockPanel.Dock="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </ui:Card>

                            <ui:Button Content="Remove this AI" Icon="{ui:SymbolIcon Delete24}" Margin="0,28,0,0" Click="Remove_Click" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Settings -->
                    <ScrollViewer x:Name="SettingsPanel" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                        <StackPanel Margin="28,22,28,28">
                            <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" />

                            <TextBlock Text="Show the countdown" Style="{StaticResource SectionTitle}" />
                            <ui:Card Padding="16,10">
                                <StackPanel>
                                    <RadioButton x:Name="ModeTaskbar" GroupName="Mode" Margin="0,4" Checked="Mode_Checked">
                                        <StackPanel>
                                            <TextBlock Text="In the taskbar" FontWeight="SemiBold" />
                                            <TextBlock Text="Next to the clock, so it never covers anything. Hover to see every countdown." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeIsland" GroupName="Mode" Margin="0,4" Checked="Mode_Checked">
                                        <StackPanel>
                                            <TextBlock Text="Floating island" FontWeight="SemiBold" />
                                            <TextBlock Text="A small pill you can drag anywhere. It fades away when your mouse passes over it." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="ModeTray" GroupName="Mode" Margin="0,4" Checked="Mode_Checked">
                                        <StackPanel>
                                            <TextBlock Text="Tray icon only" FontWeight="SemiBold" />
                                            <TextBlock Text="Right-click the tray icon to see your countdowns." Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </RadioButton>
                                </StackPanel>
                            </ui:Card>

                            <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl Icon="{ui:SymbolIcon Clock24}" Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <TextBlock Text="12-hour time (AM/PM)" FontWeight="SemiBold" />
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="AmPmSwitch" Checked="AmPm_Toggled" Unchecked="AmPm_Toggled" />
                            </ui:CardControl>
                            <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,4">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Notify me when a limit resets" FontWeight="SemiBold" />
                                        <TextBlock Text="Both weekly resets and session windows" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="NotifySwitch" Checked="Notify_Toggled" Unchecked="Notify_Toggled" />
                            </ui:CardControl>
                            <ui:CardControl Icon="{ui:SymbolIcon Power24}">
                                <ui:CardControl.Header>
                                    <TextBlock Text="Start with Windows" FontWeight="SemiBold" />
                                </ui:CardControl.Header>
                                <ui:ToggleSwitch x:Name="StartupSwitch" Checked="Startup_Toggled" Unchecked="Startup_Toggled" />
                            </ui:CardControl>

                            <TextBlock Text="About" Style="{StaticResource SectionTitle}" />
                            <ui:CardControl Icon="{ui:SymbolIcon Folder24}">
                                <ui:CardControl.Header>
                                    <StackPanel>
                                        <TextBlock Text="Your data" FontWeight="SemiBold" />
                                        <TextBlock x:Name="DataPath" Style="{StaticResource Caption}" />
                                    </StackPanel>
                                </ui:CardControl.Header>
                                <ui:Button Content="Open folder" Click="OpenFolder_Click" />
                            </ui:CardControl>
                            <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" Margin="2,14,0,0" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
