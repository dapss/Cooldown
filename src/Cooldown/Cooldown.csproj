<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Only for the tray icon (NotifyIcon); its namespaces aren't imported everywhere, to avoid
         clashing with WPF's Button, Application and so on. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Cooldown.ico</ApplicationIcon>
    <AssemblyName>Cooldown</AssemblyName>
    <RootNamespace>Cooldown</RootNamespace>
    <Version>2.1.0</Version>
    <!-- Shown as the app's name on Windows notifications and in Task Manager. -->
    <Product>Cooldown</Product>
    <AssemblyTitle>Cooldown</AssemblyTitle>
    <Description>Cooldown</Description>
    <!-- The DPI awareness in app.manifest is for WPF; this warning is about WinForms-only apps. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Cooldown.png is the window and title bar icon; Cooldown.ico (above) is the exe's.
         Both are made from Cooldown-source.webp by Assets\make-icon.py. -->
    <Resource Include="Assets\Cooldown.png" />
    <None Remove="Assets\Cooldown-source.webp;Assets\make-icon.py" />
  </ItemGroup>

</Project>
