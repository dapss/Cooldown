<Window x:Class="Cooldown.IslandWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Cooldown"
        Title="Cooldown" AutomationProperties.Name="Cooldown countdown" AllowsTransparency="True" WindowStyle="None" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False" ResizeMode="NoResize"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI">
    <!-- The island is always dark, whatever the Windows theme, except the collapsed pill on a light taskbar. -->
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />
        <local:HoverHint x:Key="HoverHint" />
        <SolidColorBrush x:Key="Ink" Color="#F2F2F7" />
        <SolidColorBrush x:Key="InkSoft" Color="#C8F2F2F7" />
        <SolidColorBrush x:Key="Muted" Color="#A0A0A8" />
        <SolidColorBrush x:Key="Track" Color="#2E2E34" />
        <SolidColorBrush x:Key="Green" Color="#78C896" />
        <SolidColorBrush x:Key="Orange" Color="#FF9F0A" />

        <Style x:Key="Small" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="WeekCountdown" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Soon}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource Green}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WeekBar" TargetType="local:Bar">
            <Setter Property="Fill" Value="{StaticResource InkSoft}" />
            <Setter Property="Track" Value="{StaticResource Track}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Soon}" Value="True">
                    <Setter Property="Fill" Value="{StaticResource Green}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- A borderless button that lights up on hover -->
        <Style x:Key="Ghost" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#14FFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#0CFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The orange Start pill -->
        <Style x:Key="Pill" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Orange}" />
            <Setter Property="Background" Value="#2EFF9F0A" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="13" Height="26" MinWidth="64" Padding="14,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#5AFF9F0A" />
                                <Setter Property="Foreground" Value="#FFD6A0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="UndoPill" TargetType="Button" BasedOn="{StaticResource Pill}">
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="Background" Value="#1CFFFFFF" />
        </Style>

        <!-- The editor's hour and minute: a capsule with arrows either side of the number -->
        <Style x:Key="Spin" TargetType="Border">
            <Setter Property="Background" Value="#1CFFFFFF" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="2,0" />
        </Style>

        <Style x:Key="SpinValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Ink}" />
            <Setter Property="MinWidth" Value="24" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Hold to keep stepping -->
        <Style x:Key="Step" TargetType="RepeatButton">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Delay" Value="400" />
            <Setter Property="Interval" Value="70" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="12" Width="24" Height="24">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#1EFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#10FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The running session and its editor take turns in one spot: whichever appears fades in while
             the card eases to its new height. -->
        <Style x:Key="SessionBlock" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SessionShown}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SessionEditor" TargetType="Border">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Editing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.2" To="1" Duration="0:0:0.2" />
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CardRow" DataType="{x:Type local:ResetView}">
            <StackPanel Margin="0,0,0,16">
                <Grid>
                    <TextBlock Text="{Binding Name}" Foreground="{StaticResource Ink}" FontSize="14" FontWeight="SemiBold"
                               TextTrimming="CharacterEllipsis" Margin="0,0,120,0" />
                    <TextBlock Text="{Binding Countdown}" HorizontalAlignment="Right" Style="{StaticResource WeekCountdown}" />
                </Grid>
                <local:Bar Fraction="{Binding WeekProgress}" Style="{StaticResource WeekBar}" Margin="0,9,0,0" />
                <TextBlock Text="{Binding ScheduleText}" Style="{StaticResource Small}" Margin="0,6,0,0" />
                <TextBlock Text="{Binding BankedText}" Style="{StaticResource Small}" Margin="0,3,0,0"
                           Visibility="{Binding HasBanked, Converter={StaticResource Visible}}" />

                <!-- A running session, and its editor in the same spot: the area eases to the height of
                     whichever is showing. -->
                <local:SmoothHeight Margin="-8,8,-8,-4" Visibility="{Binding SessionRunning, Converter={StaticResource Visible}}">
                    <Grid>
                        <!-- A running session: click it to change when it resets, right here -->
                        <Button x:Name="SessionButton" Style="{StaticResource SessionBlock}" Command="{Binding EditCommand}" Padding="8,6,8,6"
                                AutomationProperties.HelpText="Change when it resets"
                                Visibility="{Binding SessionShown, Converter={StaticResource Visible}}">
                            <AutomationProperties.Name>
                                <MultiBinding StringFormat="{}{0}, {1} left">
                                    <Binding Path="SessionLabel" />
                                    <Binding Path="SessionCountdown" />
                                </MultiBinding>
                            </AutomationProperties.Name>
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="{Binding SessionLabel}" Style="{StaticResource Small}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                    <TextBlock Text="{Binding SessionCountdown}" HorizontalAlignment="Right" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Orange}" />
                                </Grid>
                                <local:Bar Fraction="{Binding SessionProgress}" Fill="{StaticResource Orange}" Track="{StaticResource Track}" Margin="0,8,0,0" />
                                <Grid Margin="0,6,0,0" MinHeight="26">
                                    <TextBlock Text="{Binding SessionResetText}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,70,0" />
                                    <!-- The hint that it can be changed: on hover, where Undo isn't -->
                                    <TextBlock Text="Change" Style="{StaticResource Small}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0">
                                        <TextBlock.Visibility>
                                            <MultiBinding Converter="{StaticResource HoverHint}">
                                                <Binding Path="IsMouseOver" ElementName="SessionButton" />
                                                <Binding Path="ShowUndo" />
                                            </MultiBinding>
                                        </TextBlock.Visibility>
                                    </TextBlock>
                                    <Button Content="Undo" AutomationProperties.Name="Undo start" Style="{StaticResource UndoPill}" Command="{Binding UndoCommand}" HorizontalAlignment="Right"
                                            Visibility="{Binding ShowUndo, Converter={StaticResource Visible}}" />
                                </Grid>
                            </StackPanel>
                        </Button>

                        <!-- Changing when the running session resets. Mouse only: the island never takes the
                             keyboard from the app you're in. Click or hold the arrows, or scroll on a number. -->
                        <Border Style="{StaticResource SessionEditor}" Padding="10,8,8,8" CornerRadius="8" Background="#14FFFFFF"
                                Visibility="{Binding Editing, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Style="{StaticResource Small}" Foreground="{StaticResource Ink}">
                                        <Run Text="{Binding SessionLabel, Mode=OneWay}" /><Run Text=" resets at" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding DraftLeft}" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Orange}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                                    <Border Style="{StaticResource Spin}" MouseWheel="Hour_Wheel" ToolTip="Hour">
                                        <StackPanel Orientation="Horizontal">
                                            <RepeatButton Style="{StaticResource Step}" Content="&#xE70D;" Command="{Binding HourDownCommand}" AutomationProperties.Name="Hour earlier" />
                                            <TextBlock Text="{Binding DraftHour}" Style="{StaticResource SpinValue}" />
                                            <RepeatButton Style="{StaticResource Step}" Content="&#xE70E;" Command="{Binding HourUpCommand}" AutomationProperties.Name="Hour later" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text=":" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="6,0,6,2" />
                                    <Border Style="{StaticResource Spin}" MouseWheel="Minute_Wheel" ToolTip="Minute">
                                        <StackPanel Orientation="Horizontal">
                                            <RepeatButton Style="{StaticResource Step}" Content="&#xE70D;" Command="{Binding MinuteDownCommand}" AutomationProperties.Name="Minute earlier" />
                                            <TextBlock Text="{Binding DraftMinute}" Style="{StaticResource SpinValue}" />
                                            <RepeatButton Style="{StaticResource Step}" Content="&#xE70E;" Command="{Binding MinuteUpCommand}" AutomationProperties.Name="Minute later" />
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="{Binding DraftSuffix}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0" />
                                </StackPanel>
                                <Grid Margin="-2,10,0,0">
                                    <Button Style="{StaticResource Ghost}" Content="End session" Command="{Binding EndNowCommand}" HorizontalAlignment="Left"
                                            AutomationProperties.HelpText="The limit has already reset" />
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Style="{StaticResource Ghost}" Content="Cancel" Command="{Binding CancelCommand}" Margin="0,0,4,0" />
                                        <Button Style="{StaticResource Pill}" Content="Save" Command="{Binding SaveCommand}" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </local:SmoothHeight>

                <!-- A session that isn't running -->
                <Grid Margin="0,12,0,0" Visibility="{Binding SessionIdle, Converter={StaticResource Visible}}">
                    <TextBlock Style="{StaticResource Small}" VerticalAlignment="Center" Margin="0,0,80,0">
                        <Run Text="{Binding SessionLabel, Mode=OneWay}" /><Run Text=" not started" />
                    </TextBlock>
                    <Button Content="Start" Style="{StaticResource Pill}" Command="{Binding StartCommand}"
                            AutomationProperties.Name="{Binding SessionLabel, StringFormat=Start the {0}}" HorizontalAlignment="Right" />
                </Grid>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Canvas x:Name="Root">
        <Border x:Name="Shadow" Background="#FF0E0E10">
            <Border.Effect>
                <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.45" Color="Black" />
            </Border.Effect>
        </Border>
        <Border x:Name="Shape" Background="#FF0E0E10">
            <Canvas x:Name="Inner">
                <StackPanel x:Name="PillPanel" Orientation="Horizontal" Height="30">
                    <local:Ring x:Name="PillRing" Width="16" Height="16" Margin="9,0,8,0" VerticalAlignment="Center" Track="{StaticResource Track}" />
                    <TextBlock x:Name="PillName" FontSize="13" VerticalAlignment="Center" Foreground="{StaticResource Muted}"
                               MaxWidth="120" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="PillCount" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="8,0,14,0" />
                </StackPanel>

                <StackPanel x:Name="CardPanel" Width="320">
                    <TextBlock x:Name="CardEmpty" Text="No AIs yet" Foreground="{StaticResource Muted}" FontSize="14" Margin="18,18,18,16" />
                    <ItemsControl x:Name="CardList" ItemTemplate="{StaticResource CardRow}" Margin="18,18,18,0" Focusable="False" />
                    <Border Height="1" Background="{StaticResource Track}" Margin="18,0" />
                    <Grid Margin="10,6,10,8">
                        <Button Style="{StaticResource Ghost}" Click="Edit_Click" HorizontalAlignment="Left" Content="Open Cooldown" />
                        <Button Style="{StaticResource Ghost}" Click="More_Click" HorizontalAlignment="Right" Padding="10,5" ToolTip="More"
                                AutomationProperties.Name="More options">
                            <TextBlock Text="•••" FontSize="10" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Canvas>
        </Border>
        <Border x:Name="Outline" BorderBrush="#1EFFFFFF" BorderThickness="1" IsHitTestVisible="False" />
    </Canvas>
</Window>
